{
  "name": "formo-react-native",
  "version": "0.1.0",
  "description": "Formo — forms as objects — rough React Native port of formo-vue.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmidget/formo-react-native.git"
  },
  "homepage": "https://bmidget.github.io/formo-react-native/",
  "bugs": {
    "url": "https://github.com/bmidget/formo-react-native/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "preview:docs": "vitepress preview docs",
    "build:playground": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-web": "^0.21.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  }
}

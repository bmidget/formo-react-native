{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "formo-react-native": ["./src/index.ts"],
      "formo-react-native/schema": ["./src/schema/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "playground/**/*.ts", "playground/**/*.tsx", "tests/**/*.ts"]
}
